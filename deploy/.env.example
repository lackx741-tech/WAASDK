# ══════════════════════════════════════════════════════════════════════════════
# IntegratedDEX WaaS Platform — Production Environment
# Copy this file: cp .env.example .env
# Then fill in your real values
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# API key for legacy endpoints (sessions, transactions, analytics)
API_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# JWT secret for console auth (min 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Handled by Docker — no need to change unless using external MongoDB
MONGODB_URI=mongodb://mongo:27017/waassdk

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# 2. Get chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# ── Blockchain RPCs ───────────────────────────────────────────────────────────
# Free public RPCs work but are rate-limited. Use Infura/Alchemy for production.
RPC_URL_ETHEREUM=https://eth.llamarpc.com
RPC_URL_BSC=https://bsc-dataseed.binance.org
RPC_URL_POLYGON=https://polygon-rpc.com

# ── Gas Sponsorship ───────────────────────────────────────────────────────────
# Private key of the wallet that pays gas for sponsored transactions
# ⚠️  NEVER share this. Fund this wallet with small amounts only.
SPONSOR_PRIVATE_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://console.yourdomain.com
